# Optional explanation wording only. Forecasts, priorities, ownership, and
# recommended actions are deterministic and work without a vendor API key.
EXPLANATION_PROVIDER=groq
GROQ_API_KEY=
# Optional preference; the backend verifies availability before use.
GROQ_EXPLANATION_MODEL=

# To use Grok instead:
# EXPLANATION_PROVIDER=grok
# XAI_API_KEY=
# GROK_EXPLANATION_MODEL=grok-3-mini

# To use Gemini instead:
# EXPLANATION_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_EXPLANATION_MODEL=gemini-2.5-flash-lite

EXPLANATION_TIMEOUT_SECONDS=8

# Optional runtime data directory. Defaults to the repository's .data folder.
# SUPER_AGENT_DATA=/absolute/path/to/data
